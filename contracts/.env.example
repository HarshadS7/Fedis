# Foundry deployment/seed configuration.
# Copy to contracts/.env, then run: source .env
# Never commit contracts/.env or paste a real private key into chat.

# Local Anvil only. Replace with a funded, disposable Monad testnet key for 10143.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional authorized middleware address. Defaults to the deployer when blank/unset.
# For local demo this matches Anvil account 0.
MIDDLEWARE=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Optional existing settlement token. Leave unset locally to deploy MockUSDC.
# USDC=

# Monad testnet reference:
# RPC URL: https://testnet-rpc.monad.xyz
# Chain ID: 10143
# Explorer: https://testnet.monadscan.com
# Faucet: https://faucet.monad.xyz
