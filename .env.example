# Fedis app/API configuration
# Copy to .env.local (or .env for server-side scripts). Never commit the copy.

# Local Anvil demo chain. For Monad testnet use:
# fedis_RPC_URL=https://testnet-rpc.monad.xyz
# fedis_CHAIN_ID=10143
fedis_RPC_URL=http://127.0.0.1:8545
fedis_CHAIN_ID=31337
NEXT_PUBLIC_fedis_CHAIN_ID=31337

# Leave unset for automatic live/mock detection.
# Set to mock to force fixtures, or live to request the live chain path.
fedis_API_MODE=

# Required only for API write endpoints (/api/tasks, /bond, /submit).
# This is Anvil's public dev key and is unsafe for any real network.
fedis_MIDDLEWARE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional benchmark node.
fedis_BENCH_RPC=http://127.0.0.1:8547

# Optional legacy frontend flags; normally leave unset.
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_FORCE_MOCK=0
